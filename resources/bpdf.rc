#include "version.inc"

#define RT_MANIFEST 24
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L

1 ICON "bpdf.ico"
2 ICON "merge.ico"
3 ICON "ocr.ico"
4 ICON "strip.ico"
5 ICON "split.ico"
6 ICON "extract.ico"
7 ICON "inspect.ico"
8 ICON "rotate.ico"
9 ICON "resize.ico"
10 ICON "text.ico"
11 ICON "doctor.ico"
12 ICON "stamp.ico"
13 ICON "optimize.ico"
14 ICON "metadata.ico"
15 ICON "convert.ico"

1 RT_MANIFEST "bpdf.manifest"

1 VERSIONINFO
 FILEVERSION BPDF_VERSION_NUMERIC
 PRODUCTVERSION BPDF_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "bpdf project\0"
            VALUE "FileDescription", "Lightweight PDF and document toolkit\0"
            VALUE "FileVersion", BPDF_VERSION_STRING
            VALUE "InternalName", "bpdf\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 bpdf contributors\0"
            VALUE "OriginalFilename", "bpdf.exe\0"
            VALUE "ProductName", "bpdf\0"
            VALUE "ProductVersion", BPDF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
