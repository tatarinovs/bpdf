[Buttonbar]
Buttoncount=13
button1=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,1
cmd1=%COMMANDER_PATH%\tools\bpdf\bpdf.exe merge --optimize --auto-rotate -s A4
param1=@"%UL"
iconic1=0
menu1=Объединить в PDF
button2=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,2
cmd2=%COMMANDER_PATH%\tools\bpdf\bpdf.exe ocr
param2=@"%UL"
iconic2=0
menu2=Распознать текст (OCR)
button3=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,2
cmd3=%COMMANDER_PATH%\tools\bpdf\bpdf.exe ocr --engine windows --in-place
param3=@"%UL"
iconic3=0
menu3=Распознать текст (OCR in-place)
button4=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,3
cmd4=%COMMANDER_PATH%\tools\bpdf\bpdf.exe strip
param4=%P%N
iconic4=0
menu4=Удалить метаданные
button5=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,4
cmd5=%COMMANDER_PATH%\tools\bpdf\bpdf.exe split
param5=%P%N
iconic5=0
menu5=Разбить PDF постранично
button6=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,5
cmd6=%COMMANDER_PATH%\tools\bpdf\bpdf.exe extract
param6=?%P%N 1-5 "%P%O_extract.pdf"
iconic6=0
menu6=Извлечь страницы из PDF
button7=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,6
cmd7=%COMMANDER_PATH%\tools\bpdf\bpdf.exe inspect
param7=%P%N
menu7=Инспекция структуры PDF
button8=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,7
cmd8=%COMMANDER_PATH%\tools\bpdf\bpdf.exe rotate
param8=?%P%N 90
iconic8=0
menu8=Повернуть страницы (PDF, JPEG)
button9=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,8
cmd9=%COMMANDER_PATH%\tools\bpdf\bpdf.exe resize
param9=?%P%N --size A4
iconic9=0
menu9=Изменить размер страниц (PDF, JPEG)
button10=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,9
cmd10=%COMMANDER_PATH%\tools\bpdf\bpdf.exe text
param10=%P%N --out "%P%O.txt"
iconic10=0
menu10=Извлечь текст из PDF в TXT
button11=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,12
cmd11=%COMMANDER_PATH%\tools\bpdf\bpdf.exe optimize
param11=%P%N
iconic11=0
menu11=Оптимизировать PDF (сжатие)
button12=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,11
cmd12=%COMMANDER_PATH%\tools\bpdf\bpdf.exe stamp
param12=?%P%N "%Pseal.png"
iconic12=0
menu12=Вставить штамп в PDF
button13=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,14
cmd13=%COMMANDER_PATH%\tools\bpdf\bpdf.exe convert
param13=@"%UL"
menu13=Конвертировать в JPEG
