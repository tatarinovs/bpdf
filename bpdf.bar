[Buttonbar]
Buttoncount=10
button1=%COMMANDER_PATH%\ico\merge.ico
cmd1=%COMMANDER_PATH%\tools\bpdf\bpdf.exe merge --optimize --auto-rotate -s A4
param1=@"%UL"
iconic1=0
menu1=Объединить в PDF
button2=%COMMANDER_PATH%\ico\ocr.ico
cmd2=%COMMANDER_PATH%\tools\bpdf\bpdf.exe ocr
param2=%P%N
iconic2=0
menu2=Распознать текст (OCR)
button3=%COMMANDER_PATH%\ico\strip.ico
cmd3=%COMMANDER_PATH%\tools\bpdf\bpdf.exe strip
param3=@"%UL"
iconic3=0
menu3=Очистить метаданные
button4=%COMMANDER_PATH%\ico\split.ico
cmd4=%COMMANDER_PATH%\tools\bpdf\bpdf.exe split
param4=%P%N
iconic4=0
menu4=Разбить PDF постранично
button5=%COMMANDER_PATH%\ico\extract.ico
cmd5=%COMMANDER_PATH%\tools\bpdf\bpdf.exe extract
param5=?"%P%N" 1-5 "%P%O_extract.pdf"
iconic5=0
menu5=Извлечь страницы из PDF
button6=%COMMANDER_PATH%\ico\rotate.ico
cmd6=%COMMANDER_PATH%\tools\bpdf\bpdf.exe rotate
param6=?"%P%N" 90
iconic6=0
menu6=Повернуть страницы PDF
button7=%COMMANDER_PATH%\ico\text.ico
cmd7=%COMMANDER_PATH%\tools\bpdf\bpdf.exe text
param7=%P%N --out "%P%O.txt"
iconic7=0
menu7=Извлечь текст из PDF в TXT
button8=%COMMANDER_PATH%\ico\optimize.ico
cmd8=%COMMANDER_PATH%\tools\bpdf\bpdf.exe optimize
param8=%P%N
iconic8=0
menu8=Оптимизировать PDF (Сжатие)
button9=%COMMANDER_PATH%\ico\stamp.ico
cmd9=%COMMANDER_PATH%\tools\bpdf\bpdf.exe stamp
param9=?"%P%N" "%Pseal.png"
iconic9=0
menu9=Поставить штамп на PDF
button10=%COMMANDER_PATH%\ico\convert.ico
cmd10=%COMMANDER_PATH%\tools\bpdf\bpdf.exe convert
param10=?"%P%N"
iconic10=0
menu10=Конвертировать в JPEG
