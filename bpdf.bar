[Buttonbar]
Buttoncount=12
button1=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,1
cmd1=%COMMANDER_PATH%\tools\bpdf\bpdf.exe merge --optimize --auto-rotate -s A4
param1=@"%UL"
iconic1=0
menu1=Объединить в PDF
button2=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,2
cmd2=cmd /k %COMMANDER_PATH%\tools\bpdf\bpdf.exe ocr --engine windows
param2=@"%UL"
menu2=Распознать текст (OCR)
button3=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,3
cmd3=%COMMANDER_PATH%\tools\bpdf\bpdf.exe strip
param3=@"%UL"
iconic3=0
menu3=Удалить метаданные
button4=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,4
cmd4=%COMMANDER_PATH%\tools\bpdf\bpdf.exe split
param4=%P%N
iconic4=0
menu4=Разбить PDF постранично
button5=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,5
cmd5=%COMMANDER_PATH%\tools\bpdf\bpdf.exe extract
param5=?"%P%N" 1-5 "%P%O_extract.pdf"
iconic5=0
menu5=Извлечь страницы из PDF
button6=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,6
cmd6=%comspec% /k %COMMANDER_PATH%\tools\bpdf\bpdf.exe inspect
param6="%P%N"
iconic6=0
menu6=Инспекция структуры PDF
button7=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,7
cmd7=%COMMANDER_PATH%\tools\bpdf\bpdf.exe rotate
param7=?"%P%N" 90
iconic7=0
menu7=Повернуть страницы PDF
button8=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,8
cmd8=%COMMANDER_PATH%\tools\bpdf\bpdf.exe resize
param8=?"%P%N" --size A4
iconic8=0
menu8=Изменить размер страниц (A4/Letter)
button9=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,9
cmd9=%COMMANDER_PATH%\tools\bpdf\bpdf.exe text
param9=%P%N --out "%P%O.txt"
iconic9=0
menu9=Извлечь текст из PDF в TXT
button10=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,12
cmd10=%COMMANDER_PATH%\tools\bpdf\bpdf.exe optimize
param10=%P%N
iconic10=0
menu10=Оптимизировать PDF (сжатие)
button11=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,11
cmd11=%COMMANDER_PATH%\tools\bpdf\bpdf.exe stamp
param11=?"%P%N" "%Pseal.png"
iconic11=0
menu11=Вставить штамп в PDF
button12=%COMMANDER_PATH%\tools\bpdf\bpdf.exe,14
cmd12=%COMMANDER_PATH%\tools\bpdf\bpdf.exe convert
param12=@"%UL"
iconic12=0
menu12=Конвертировать в JPEG
