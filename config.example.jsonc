{
    // ==========================================
    // API и сеть
    // ==========================================
    
    // Ключ API Groq для работы OCR (распознавания текста на изображениях и сканах).
    "groq_api_key": "",

    // Прокси-сервер для HTTP(S) запросов (например, для обхода блокировок).
    // Поддерживаются форматы HTTP и SOCKS5. Если оставить пустым, прокси не используется.
    "proxy": "",
    // "proxy": "http://127.0.0.1:10809",
    // "proxy": "socks5://127.0.0.1:10808",

    // ==========================================
    // Метаданные PDF
    // ==========================================
    
    // Имя автора, которое будет записано в свойства создаваемых PDF документов.
    "author": "",
    
    // Название программы-создателя (Creator) в свойствах PDF.
    "creator": "",

    // ==========================================
    // Обработка PDF и изображений
    // ==========================================
    
    // Автоматический поворот страниц (например, для горизонтальных сканов).
    "auto_rotate": false,
    
    // Сохранять цветовые профили ICC при обработке изображений. (false = удалять профили для уменьшения веса)
    "keep_icc": false,
    
    // Оптимизировать структуру PDF, удалять мусор и сжимать потоки данных.
    "optimize": false,
    
    // Удалять метаданные EXIF из изображений (без перекодирования) и полностью очищать метаданные PDF.
    "strip_metadata": false,
    
    // Приведение страниц к заданному размеру (например, "A4", "Letter").
    "page_size": "A4",
    
    // Качество сжатия JPEG (от 1 до 100). Влияет на размер файла при перекодировании изображений.
    "jpeg_quality": 95,
    
    // DPI для сжатия больших изображений при объединении в PDF.
    // Например, при 150 DPI картинка, превышающая размер A4 (около 1240x1754), будет уменьшена.
    // 0 = отключить сжатие изображений под размер страницы.
    "image_dpi": 150,

    // ==========================================
    // Настройки OCR (Распознавание текста)
    // ==========================================
    
    // Модель нейросети для распознавания текста (по умолчанию qwen/qwen3.6-27b).
    "ocr_model": "qwen/qwen3.6-27b",
    
    // Кастомный промпт для OCR. Раскомментируйте, чтобы переопределить стандартный промпт.
    // "ocr_prompt": "Extract all text exactly as it appears...",
    
    // URL конечной точки (endpoint) для запросов к Groq API.
    "ocr_endpoint": "https://api.groq.com/openai/v1/chat/completions",
    
    // Количество параллельных задач (потоков) при распознавании многостраничных документов.
    "ocr_jobs": 2,
    
    // Использовать ли кэш для OCR. Помогает экономить запросы при повторной обработке тех же файлов.
    "ocr_cache": true,
    
    // Директория для хранения кэша OCR. Если закомментировано, используется системная папка (LOCALAPPDATA).
    // "ocr_cache_dir": "D:\\cache\\bpdf-ocr",
    
    // Таймаут в секундах для каждого запроса к OCR API.
    "ocr_timeout_seconds": 120,
    
    // Максимальное количество токенов в ответе OCR модели.
    // Увеличьте для больших или многостраничных документов.
    "ocr_max_tokens": 4096,

    // ==========================================
    // Внешние зависимости и пути
    // ==========================================
    
    // Путь к исполняемому файлу ffmpeg (используется для конвертации экзотических форматов, вроде HEIC/HEIF).
    "ffmpeg": "ffmpeg",
    
    // Путь к исполняемому файлу PowerShell (нужен для некоторых системных интеграций на Windows).
    "powershell": "powershell.exe",
    
    // Путь к файлу шрифта для рендеринга текста (например, для кириллицы при конвертации txt в pdf).
    // "font_path": "C:\\Windows\\Fonts\\arial.ttf",
    
    // Таймаут в секундах для конвертации Office файлов (Word/Excel) в PDF.
    "office_timeout_seconds": 120
}
